# ==============================================================================
# NEXUS Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 17)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@localhost:5432/nexus_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/nexus_db

# Fallback Local Development SQLite Database
SQLITE_DATABASE_URL=sqlite+aiosqlite:///D:/AIORI/nexus.db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Network Simulation Mode (wsl or native)
SIMULATION_BACKEND=wsl
WSL_DISTRO=Ubuntu

